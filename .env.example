# Target company symbols
TARGET_TICKERS=AAPL

# Alpha Vantage
# Used for daily market OHLCV data
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# Marketaux
# Used for financial news
MARKETAUX_API_KEY=your_marketaux_key

# SEC EDGAR
# SEC requests should identify the application and include a contact email
SEC_USER_AGENT=Investment-Research-Multi-Agent-System your-email@example.com

# Ingestion limits
SEC_FORM4_LIMIT=20
NEWS_LIMIT_PER_TICKER=9
MARKETAUX_PAGE_SIZE=3

# Set to true only when intentionally refreshing raw source data
FORCE_REFRESH=false

# LLM configuration for 03_news_processing_chain.ipynb
LLM_API_KEY=your_llm_api_key
LLM_MODEL=your_model_name

# Leave blank when using OpenAI directly.
# Set this only for another OpenAI-compatible provider.
LLM_BASE_URL=

# Number of news articles to process through the LLM chain during development
NEWS_CHAIN_LIMIT=10

# Set to true only when intentionally regenerating saved LLM results
FORCE_NEWS_CHAIN=false